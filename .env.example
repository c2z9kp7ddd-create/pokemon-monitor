# Names only: never commit real values. In the cloud these are GitHub Actions secrets
# (Settings > Secrets and variables > Actions); on the Mac, setup_phone.py writes secrets.json instead.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# optional: separate Telegram group for status / watchdog messages
TELEGRAM_STATUS_CHAT_ID=
# set by server_setup.sh on an always-on server; leave unset on the Mac
MONITOR_ROLE=
